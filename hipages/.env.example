# =============================================================
# ProConnect — Environment Variable Template
# =============================================================
# Copy this file to `.env` and fill in your values.
# NEVER commit the real `.env` file. See SECURITY.md.
# =============================================================

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
SYNC_DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<db>

# ── Cache / Broker ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT Auth ──────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Cloudflare R2 (Object Storage) ───────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ── Stripe (Payments) ─────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CREDIT_PRICE_ID=price_...

# ── Resend (Transactional Email) ──────────────────────────────
# Leave empty to print OTP to terminal in dev mode
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── App Meta ──────────────────────────────────────────────────
APP_NAME=ProConnect
ENVIRONMENT=development    # development | staging | production

# ── Mapbox (Maps) ────────────────────────────────────────────
MAPBOX_API_KEY=

# ── Sentry (Error Monitoring) ─────────────────────────────────
SENTRY_BACKEND_DSN=
SENTRY_FRONTEND_DSN=

# ── AI / LLM Providers ────────────────────────────────────────
GROQ_API_KEY=
ANTHROPIC_API_KEY=