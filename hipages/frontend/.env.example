# =============================================================
# ProConnect Frontend — Environment Variable Template
# =============================================================
# Copy to `.env.local` and fill in your values.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# =============================================================

# ── API ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Sentry (Frontend Error Monitoring) ───────────────────────
NEXT_PUBLIC_SENTRY_FRONTEND_DSN=

# ── App Environment ───────────────────────────────────────────
NEXT_PUBLIC_ENVIRONMENT=development    # development | staging | production
