# =============================================================================
# Dockerfile.dev — Development image for Next.js 15 frontend
# Tradie Platform
# =============================================================================

FROM node:20-alpine

RUN apk add --no-cache libc6-compat

WORKDIR /app

# Install dependencies first (cached layer).
COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps     # ← ONLY CHANGE: added --legacy-peer-deps

# Source is mounted as a volume in docker-compose.dev.yml
# so code changes reflect instantly without rebuilding.

EXPOSE 3000

ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["npm", "run", "dev"]