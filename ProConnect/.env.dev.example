# =============================================================================
# .env.dev.example — Local development environment variables
# Tradie Platform
# =============================================================================
#
# HOW TO USE:
#   cp .env.dev.example .env.dev
#   # Fill in only the Stripe test keys and AWS dev keys.
#   # Everything else works out of the box.
#
# This file CAN be committed as-is — all values are safe dev defaults.
# The real .env.dev you create is in .gitignore.
# =============================================================================

# =============================================================================
# STRIPE — use TEST keys (start with sk_test_ and pk_test_)
# Never use live keys locally. Live keys charge real money.
# Get test keys from: https://dashboard.stripe.com/test/apikeys
# =============================================================================
STRIPE_TEST_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_TEST_PUBLISHABLE_KEY=pk_test_CHANGE_ME

# For local webhook testing, install Stripe CLI and run:
#   stripe listen --forward-to localhost:8000/v1/payments/webhook
# It prints a webhook secret — paste it here.
STRIPE_TEST_WEBHOOK_SECRET=whsec_CHANGE_ME

# =============================================================================
# AWS — optional for local dev.
# If you want to test real S3 uploads locally, add your dev IAM credentials.
# Otherwise, the app will use mock responses for upload URL generation.
# =============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=tradie-platform-uploads-dev
AWS_S3_REGION=ap-southeast-2

# =============================================================================
# TWILIO — use TEST credentials for dev.
# Test credentials do not send real SMS but validate your integration.
# Get from: https://console.twilio.com → Account → Test Credentials
# =============================================================================
TWILIO_TEST_ACCOUNT_SID=AC_test_CHANGE_ME
TWILIO_TEST_AUTH_TOKEN=test_CHANGE_ME
