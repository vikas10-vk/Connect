# =============================================================================
# .env.prod.example â€” Production environment variables reference
# Tradie Platform
# =============================================================================
#
# THIS FILE IS SAFE TO COMMIT. It contains no real values â€” only examples
# and documentation so your team knows what variables are required.
#
# THE REAL VALUES LIVE IN:
#   GitHub â†’ Settings â†’ Secrets and variables â†’ Actions
#   They are injected into the deployment pipeline by GitHub Actions.
#   The deploy.sh script writes them to /etc/tradie/.env on the server
#   at deploy time. That file is owned by root, chmod 600.
#
# NEVER:
#   - Commit a .env file with real values to git
#   - Store secrets in docker-compose.yml directly
#   - Print secrets in logs (FastAPI's config.py must mask them)
# =============================================================================


# =============================================================================
# DOMAIN
# =============================================================================

# Your root domain. Used to construct all subdomain URLs.
DOMAIN=yourdomain.com


# =============================================================================
# DEPLOYMENT
# =============================================================================

# The git commit SHA of the currently deployed image.
# Set automatically by deploy.sh â€” you do not set this manually.
IMAGE_TAG=abc1234

# GitHub repository path (owner/repo) for the container registry URL.
GITHUB_REPOSITORY=your-github-username/tradie-platform


# =============================================================================
# DATABASE
# =============================================================================

POSTGRES_DB=tradie_production
POSTGRES_USER=tradie_app

# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_use_openssl_rand_base64_32

# Separate read-only-ish user for Django admin.
# Has SELECT on most tables, write access only where Django admin needs it.
DJANGO_DB_USER=tradie_admin_ro
DJANGO_DB_PASSWORD=CHANGE_ME_use_openssl_rand_base64_32


# =============================================================================
# REDIS
# =============================================================================

# Generate with: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME_use_openssl_rand_base64_32


# =============================================================================
# SECURITY â€” JWT
# =============================================================================

# Must be at least 32 characters. Used to sign all JWT tokens.
# If this leaks, all tokens can be forged. Rotate it and all users are logged out.
# Generate with: openssl rand -base64 48
#
# NAME MAPPING: docker-compose.prod.yml passes this value into the backend
# containers as SECRET_KEY, which is the name backend/config.py actually reads.
# Keep this CI/secret variable named JWT_SECRET_KEY.
JWT_SECRET_KEY=CHANGE_ME_use_openssl_rand_base64_48

# Used to encrypt sensitive columns (phone_real, etc.) at the application layer.
# Must be exactly 32 bytes (256-bit key for AES-256).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=CHANGE_ME_generate_fernet_key

# Owner-only admin bootstrap. This is the only supported way to create or
# promote admin users via backend/create_admin.py.
# Keep OWNER_ADMIN_EMAILS limited to addresses you personally control.
# Generate token with: python -c "import secrets; print(secrets.token_urlsafe(48))"
OWNER_ADMIN_EMAILS=you@yourdomain.com
ADMIN_BOOTSTRAP_TOKEN=CHANGE_ME_use_secrets_token_urlsafe_48


# =============================================================================
# DJANGO
# =============================================================================

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGE_ME_use_secrets_token_urlsafe_50




# =============================================================================
# AWS â€” S3 + CloudFront
# =============================================================================

# IAM user with permissions: s3:PutObject, s3:GetObject, s3:DeleteObject
# on your specific bucket only (not s3:*).
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME

# S3 bucket name â€” should be private. Files served via CloudFront, not direct S3.
AWS_S3_BUCKET=tradie-platform-uploads-prod
AWS_S3_REGION=ap-southeast-2

# CloudFront distribution domain (e.g. d1234abcd.cloudfront.net)
# Files are served as: https://<CLOUDFRONT_DOMAIN>/uploads/<file_key>
CLOUDFRONT_DOMAIN=CHANGE_ME.cloudfront.net


# =============================================================================
# TWILIO â€” Phone number masking + SMS
# =============================================================================

# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACCHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME

# Twilio Proxy Service SID â€” for phone number masking.
# Create a Proxy Service in Twilio console and paste the SID here.
TWILIO_PROXY_SERVICE=KSCHANGE_ME


# =============================================================================
# FIREBASE â€” Push notifications (FCM)
# =============================================================================

# Service account JSON â€” download from Firebase console:
# Project Settings â†’ Service accounts â†’ Generate new private key
# Paste the ENTIRE JSON as a single line (escape the quotes).
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"CHANGE_ME",...}


# =============================================================================
# GOOGLE reCAPTCHA v3
# =============================================================================

# Get from: https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=CHANGE_ME
RECAPTCHA_SITE_KEY=CHANGE_ME


# =============================================================================
# SENTRY â€” Error monitoring
# =============================================================================

# Get from: https://sentry.io â†’ Project Settings â†’ Client Keys
# Backend (FastAPI + Celery)
#
# NAME MAPPING: docker-compose.prod.yml passes this value into the FastAPI and
# Celery containers as SENTRY_BACKEND_DSN, the name backend/config.py reads.
# The Django admin container still receives it as SENTRY_DSN.
# Sentry is MANDATORY in production â€” the backend refuses to boot without it.
SENTRY_DSN=https://CHANGE_ME@o0.ingest.sentry.io/0

# Frontend (Next.js)
SENTRY_DSN_FRONTEND=https://CHANGE_ME@o0.ingest.sentry.io/1


# =============================================================================
# NEXT.JS
# =============================================================================

# Used for NextAuth.js session signing.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_use_openssl_rand_base64_32


# =============================================================================
# CELERY FLOWER â€” task monitor (internal, SSH tunnel only)
# =============================================================================

FLOWER_USER=admin
FLOWER_PASSWORD=CHANGE_ME_strong_password


# =============================================================================
# NOTIFICATIONS (email for system alerts â€” not user emails)
# =============================================================================

# SMTP for system alerts (Celery failures, disk space warnings, etc.)
# Use a transactional email provider: Postmark, Resend, AWS SES.
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=alerts@yourdomain.com

# Where to send system alert emails.
ALERT_EMAIL=you@yourdomain.com

# Slack webhook URL for deploy notifications and alerts.
# Create an Incoming Webhook app in your Slack workspace.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE_ME/CHANGE_ME/CHANGE_ME
